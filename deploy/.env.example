# POM 部署环境变量样例：复制为 .env 后修改（.env 不入 git）

# --- 必填 ---
# JWT 签名密钥：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-hex
# PostgreSQL 密码
POSTGRES_PASSWORD=change-me-strong-password

# --- 可选 ---
# 对外 HTTP 端口（建议由云 LB/证书提供 HTTPS 后转发至此）
HTTP_PORT=80
# 会话有效期（小时）
SESSION_TTL_HOURS=12
# 单文件上传上限（MB）
MAX_UPLOAD_MB=20
